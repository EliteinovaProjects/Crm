# =============================================================================
# Frontend environment variables
# Copy this file to `frontend/.env` (or `.env.production`) and fill in values.
# On Vercel, add these same keys under
#   Project -> Settings -> Environment Variables
# =============================================================================

# Base URL of the deployed backend API.
#
# Leave this UNSET when the backend is served under the same domain at /api
# (e.g. the Vite dev proxy locally, or a Vercel rewrite that forwards /api/*).
#
# Set it to the backend service URL when the frontend and backend are deployed
# as two separate Vercel projects, e.g.:
#   VITE_API_URL=https://crm-backend.vercel.app
#
# Do NOT include a trailing slash.
VITE_API_URL= https://crm-backend-liard-kappa.vercel.app/
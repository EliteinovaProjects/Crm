# =============================================================================
# Backend environment variables (local development)
# Copy this file to `backend/.env` and fill in the values.
# On Vercel, add these same keys under
#   Project -> Settings -> Environment Variables
# =============================================================================

# --- Neon Postgres -----------------------------------------------------------
# Use the **pooled** connection string from the Neon dashboard
# (it contains `-pooler` in the host) for the running application.
# Neon always requires SSL, e.g.:
#   postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Security ----------------------------------------------------------------
# Generate a strong random value, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Optional services -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- CORS --------------------------------------------------------------------
# Comma separated list of allowed frontend origins (no trailing slash).
# Add your production Vercel frontend URL here.
CORS_ORIGINS_RAW=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app